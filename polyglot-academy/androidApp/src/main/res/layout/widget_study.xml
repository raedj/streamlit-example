<?xml version="1.0" encoding="utf-8"?>
<!-- Texts follow their own direction (the interface may differ from the device language). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="14dp"
    android:background="@drawable/widget_background">

    <TextView
        android:id="@+id/widget_title"
        style="@style/WidgetText"
        android:textSize="13sp"
        android:textColor="@color/widget_accent"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_progress"
        style="@style/WidgetText"
        android:layout_marginTop="2dp"
        android:textSize="15sp"
        android:textColor="@color/widget_text" />

    <TextView
        android:id="@+id/widget_next"
        style="@style/WidgetText"
        android:textSize="13sp"
        android:textColor="@color/widget_text_secondary" />

    <TextView
        android:id="@+id/widget_word_label"
        style="@style/WidgetText"
        android:layout_marginTop="8dp"
        android:textSize="12sp"
        android:textColor="@color/widget_text_secondary" />

    <TextView
        android:id="@+id/widget_word"
        style="@style/WidgetText"
        android:textSize="20sp"
        android:textColor="@color/widget_text" />

    <TextView
        android:id="@+id/widget_meaning"
        style="@style/WidgetText"
        android:textSize="13sp"
        android:textColor="@color/widget_text_secondary" />
</LinearLayout>
