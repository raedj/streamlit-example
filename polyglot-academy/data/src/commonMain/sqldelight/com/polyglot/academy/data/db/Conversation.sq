CREATE TABLE conversation (
    id TEXT NOT NULL PRIMARY KEY,
    language TEXT NOT NULL,
    tutor_id TEXT NOT NULL,
    scenario_id TEXT,
    started_at INTEGER NOT NULL,
    ended_at INTEGER,
    summary TEXT
);
CREATE INDEX conversation_lang_time ON conversation(language, started_at);

CREATE TABLE conversation_turn (
    id TEXT NOT NULL PRIMARY KEY,
    conversation_id TEXT NOT NULL REFERENCES conversation(id) ON DELETE CASCADE,
    speaker TEXT NOT NULL,
    text TEXT NOT NULL,
    translation TEXT,
    corrections_json TEXT NOT NULL,
    alternatives_json TEXT NOT NULL,
    vocabulary_json TEXT NOT NULL,
    created_at INTEGER NOT NULL,
    produced_by TEXT,
    was_spoken INTEGER NOT NULL
);
CREATE INDEX conversation_turn_conv_time ON conversation_turn(conversation_id, created_at);

-- Never use INSERT OR REPLACE here: REPLACE deletes the row first and ON DELETE CASCADE would erase its turns.
-- (UPSERT syntax needs SQLite 3.24, newer than Android API 26.)
insertConversationIfAbsent:
INSERT OR IGNORE INTO conversation VALUES (?, ?, ?, ?, ?, ?, ?);
updateConversation:
UPDATE conversation SET language = ?, tutor_id = ?, scenario_id = ?, started_at = ?, ended_at = ?, summary = ? WHERE id = ?;
conversationsForLanguage:
SELECT * FROM conversation WHERE language = ? ORDER BY started_at DESC;
insertTurn:
INSERT OR REPLACE INTO conversation_turn VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);
turnsFor:
SELECT * FROM conversation_turn WHERE conversation_id = ? ORDER BY created_at, rowid;
learnerTurnCount:
SELECT COUNT(*) FROM conversation_turn t JOIN conversation c ON c.id = t.conversation_id WHERE c.language = ? AND t.speaker = 'LEARNER';
allConversations:
SELECT * FROM conversation ORDER BY started_at;
allTurns:
SELECT * FROM conversation_turn ORDER BY created_at;

deleteAllConversations {
    DELETE FROM conversation_turn;
    DELETE FROM conversation;
}
